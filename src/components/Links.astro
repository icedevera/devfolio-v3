---
import { getCollection } from "astro:content";
import { formatDate, LINKS } from "../site";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<nav aria-label="Links">
  {
    LINKS.map((link) => (
      <a href={link.href} target="_blank" rel="noopener">
        {link.name}
        <svg viewBox="0 0 10 10" role="img" aria-label="(opens in a new tab)">
          <path d="M1.5 8.5l7-7M3 1.5h5.5V7" />
        </svg>
      </a>
    ))
  }
  <details class="writing">
    <summary>Writing</summary>
    <ul>
      {
        articles.map((article) => (
          <li>
            <a href={`/articles/${article.id}`}>
              <span class="title">{article.data.title}</span>
              <time class="muted" datetime={article.data.date.toISOString().slice(0, 10)}>
                {formatDate(article.data.date, "short")}
              </time>
              <span class="about muted">{article.data.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</nav>

<script>
  // Escape, or a press anywhere else, puts the list away.
  const writing = document.querySelector<HTMLDetailsElement>(".writing");
  if (writing) {
    addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !writing.open) return;
      if (writing.contains(document.activeElement)) writing.querySelector("summary")?.focus();
      writing.open = false;
    });
    addEventListener("pointerdown", (event) => {
      if (writing.open && event.target instanceof Node && !writing.contains(event.target)) writing.open = false;
    });
  }
</script>

<style>
  nav {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0 3ch;
  }

  svg {
    width: 0.7em;
    height: 0.7em;
    margin-left: 0.35em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
  }

  summary {
    display: block;
    text-decoration: underline 1px rgb(228 220 203 / 0.3);
    text-underline-offset: 0.25em;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  [open] > summary {
    color: var(--blossom);
    text-decoration-color: currentColor;
  }

  /* The list opens over the scene, just above the links, on solid soil so
     the grey text stays readable over a bright sky. It sits above the
     stage dots, which can reach under it on narrow screens. */
  ul {
    position: absolute;
    bottom: calc(100% + 0.75rem);
    left: 0;
    z-index: 2;
    width: min(52ch, calc(100vw - 3rem));
    max-height: min(28rem, 60svh);
    margin: 0;
    padding: 0.375rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid rgb(228 220 203 / 0.14);
    border-radius: 4px;
    background: var(--soil);
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.35);
    list-style: none;
    text-shadow: none;
    cursor: default;
    animation: rise 0.2s ease-out;
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 0.375rem;
    }
  }

  li + li {
    border-top: 1px solid rgb(228 220 203 / 0.08);
  }

  li a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 2ch;
    padding: 0.625rem 0.75rem;
    border-radius: 2px;
    text-decoration: none;
  }

  li a:hover,
  li a:focus-visible {
    background: rgb(228 220 203 / 0.06);
  }

  .title {
    text-decoration: underline 1px rgb(228 220 203 / 0.3);
    text-underline-offset: 0.25em;
  }

  li a:hover .title {
    text-decoration-color: currentColor;
  }

  .about {
    grid-column: 1 / -1;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    ul {
      animation: none;
    }
  }
</style>
