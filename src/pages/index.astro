---
import Links from "../components/Links.astro";
import Name from "../components/Name.astro";
import Base from "../layouts/Base.astro";
---

<Base>
  <div class="home">
    <canvas class="flat" aria-hidden="true"></canvas>
    <canvas class="depth" aria-hidden="true"></canvas>
    <canvas class="real" aria-hidden="true"></canvas>
    <canvas class="over" aria-hidden="true"></canvas>
    <div class="shade" aria-hidden="true"></div>
    <main>
      <div class="intro">
        <h1><Name /></h1>
        <p>Software engineer<br />Building <a href="https://dohc.computer">dohc.computer</a></p>
      </div>

      <div class="links"><Links /></div>

      <div class="garden">
        <ol class="stages" aria-label="Stages" data-stages></ol>
        <p class="muted">
          <span data-stage>Tree</span>
          <button type="button" data-plant>Plant another</button>
        </p>
      </div>
    </main>
  </div>

  <script>
    import { mountScene } from "../scene";

    const root = document.querySelector<HTMLElement>(".home");
    if (root) mountScene(root);
  </script>
</Base>

<style>
  /* One screen: the scene behind, the words in its corners. */
  .home {
    position: relative;
  }

  canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .depth,
  .real {
    opacity: 0;
  }

  main {
    display: grid;
    grid-template:
      "intro intro" 1fr
      "links garden" auto
      / 1fr auto;
    gap: 1.5rem 3ch;
    max-width: none;
    min-height: 100vh;
    min-height: 100svh;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    font-weight: 380;
    text-shadow:
      0 0 4px var(--soil),
      0 0 12px var(--soil);
  }

  .intro {
    grid-area: intro;
    place-self: start;
    max-width: 36ch;
  }

  /* The name is the page's title, second only to the tree; the rest is set a
     little heavier than the site's body text, so it holds against the scene. */
  h1 {
    margin-bottom: 0.6rem;
    white-space: nowrap;
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .intro p {
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .links {
    grid-area: links;
    align-self: end;
    justify-self: start;
  }

  /* Darkens the sky a little behind the words, so they read on a bright day. */
  .shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 42rem 18rem at 11rem 6.5rem, rgb(22 20 17 / 0.62), rgb(22 20 17 / 0.34) 40%, transparent),
      linear-gradient(to top, rgb(22 20 17 / calc(0.5 + 0.3 * var(--real, 0))), transparent calc(8rem + 3rem * var(--real, 0)));
    pointer-events: none;
  }

  /* Once the scene is 3D, it turns when dragged. */
  .turnable {
    cursor: grab;
    touch-action: pan-y;
  }

  .turning {
    cursor: grabbing;
    user-select: none;
  }

  .garden {
    grid-area: garden;
    align-self: end;
    justify-self: end;
    width: 18rem;
    max-width: 100%;
  }

  .garden p {
    display: flex;
    justify-content: space-between;
    gap: 2ch;
  }

  /* One dot a stage on a line that fills as the scene moves on. The script
     adds the dots, so they're styled globally. */
  .stages {
    --progress: 0;
    /* The line runs between the middles of the first and last dots. */
    --inset: calc(50% / var(--count, 11));
    position: relative;
    display: flex;
    margin: 0 0 0.25rem;
    padding: 0;
    list-style: none;
  }

  .stages::before,
  .stages::after {
    position: absolute;
    top: 50%;
    left: var(--inset);
    height: 1px;
    content: "";
  }

  .stages::before {
    right: var(--inset);
    background: rgb(141 134 118 / 0.45);
  }

  .stages::after {
    width: calc((100% - 2 * var(--inset)) * var(--progress));
    background: var(--text);
  }

  .stages :global(li) {
    flex: 1;
  }

  .stages :global(button) {
    position: relative;
    z-index: 1;
    display: grid;
    width: 100%;
    height: 1.75rem;
    place-items: center;
  }

  .stages :global(button)::before {
    width: 0.4375rem;
    height: 0.4375rem;
    border: 1px solid var(--muted);
    border-radius: 50%;
    background: var(--soil);
    content: "";
    transition:
      background 0.3s,
      border-color 0.3s,
      scale 0.3s;
  }

  .stages :global(.past)::before {
    border-color: var(--text);
    background: var(--text);
  }

  .stages :global([aria-current])::before,
  .stages :global(button:hover)::before {
    border-color: var(--blossom);
    background: var(--blossom);
    scale: 1.3;
  }

  @media (max-width: 40rem) and (orientation: portrait) {
    main {
      grid-template:
        "intro" 1fr
        "links" auto
        "garden" auto
        / 1fr;
      row-gap: 0.5rem;
    }

    .garden {
      justify-self: stretch;
      width: auto;
      margin-top: 0.5rem;
    }

    .shade {
      background:
        linear-gradient(rgb(22 20 17 / 0.55), transparent 14rem),
        linear-gradient(to top, rgb(22 20 17 / calc(0.55 + 0.25 * var(--real, 0))), transparent 12rem);
    }
  }
</style>
